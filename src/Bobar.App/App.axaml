<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bobar.App.ViewModels"
             x:Class="Bobar.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BugBg" Color="#FBE3E1" /><SolidColorBrush x:Key="BugFg" Color="#A1261A" />
          <SolidColorBrush x:Key="RiskBg" Color="#FDEBE0" /><SolidColorBrush x:Key="RiskFg" Color="#9A3B08" />
          <SolidColorBrush x:Key="DesignBg" Color="#EFE8F8" /><SolidColorBrush x:Key="DesignFg" Color="#5B3E8C" />
          <SolidColorBrush x:Key="NitBg" Color="#EDEDED" /><SolidColorBrush x:Key="NitFg" Color="#474747" />
          <SolidColorBrush x:Key="FixFg" Color="#0E6B0E" />
          <SolidColorBrush x:Key="RejectFg" Color="#A13D00" />
          <SolidColorBrush x:Key="LiveBg" Color="#1A2D87D7" /><SolidColorBrush x:Key="LiveFg" Color="#005A9E" />
          <SolidColorBrush x:Key="AwaitBg" Color="#17FFB100" /><SolidColorBrush x:Key="AwaitFg" Color="#7A4A00" />
          <SolidColorBrush x:Key="TableHeaderBg" Color="#08000000" />
          <SolidColorBrush x:Key="TableTotalBg" Color="#05000000" />
          <SolidColorBrush x:Key="TableBorder" Color="#1A000000" />
          <SolidColorBrush x:Key="RowBorder" Color="#12000000" />
          <SolidColorBrush x:Key="RowHoverBg" Color="#0C000000" />
          <SolidColorBrush x:Key="RowOpenBg" Color="#08000000" />
          <SolidColorBrush x:Key="OutcomeBg" Color="#0C000000" />
          <SolidColorBrush x:Key="MutedFg" Color="#5C5C5C" />
          <SolidColorBrush x:Key="SidebarBg" Color="#00EEEEEE" />
          <SolidColorBrush x:Key="SidebarFallbackBg" Color="#EEEEEE" />
          <!-- The run pane: the sidebar's backdrop, half as transparent -->
          <SolidColorBrush x:Key="MainBg" Color="#80EEEEEE" />
          <!-- Over the bare blurred wallpaper (Windows: WallpaperBrush), sidebar and run pane -->
          <SolidColorBrush x:Key="SidebarWallpaperTint" Color="#B3F3F3F3" />
          <SolidColorBrush x:Key="MainWallpaperTint" Color="#D9F3F3F3" />
          <SolidColorBrush x:Key="SidebarDivider" Color="#14000000" />
          <SolidColorBrush x:Key="CardBg" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="RunSelectedBg" Color="#14000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BugBg" Color="#4D1F1B" /><SolidColorBrush x:Key="BugFg" Color="#FFA49A" />
          <SolidColorBrush x:Key="RiskBg" Color="#4A2A17" /><SolidColorBrush x:Key="RiskFg" Color="#FFB68C" />
          <SolidColorBrush x:Key="DesignBg" Color="#3A2E4F" /><SolidColorBrush x:Key="DesignFg" Color="#D2BDF5" />
          <SolidColorBrush x:Key="NitBg" Color="#383838" /><SolidColorBrush x:Key="NitFg" Color="#D6D6D6" />
          <SolidColorBrush x:Key="FixFg" Color="#6CCB5F" />
          <SolidColorBrush x:Key="RejectFg" Color="#FFB68C" />
          <SolidColorBrush x:Key="LiveBg" Color="#3396D2FF" /><SolidColorBrush x:Key="LiveFg" Color="#9CD6FF" />
          <SolidColorBrush x:Key="AwaitBg" Color="#3BFCC84E" /><SolidColorBrush x:Key="AwaitFg" Color="#FFD68A" />
          <SolidColorBrush x:Key="TableHeaderBg" Color="#27FFFFFF" />
          <SolidColorBrush x:Key="TableTotalBg" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="TableBorder" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="RowBorder" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="RowHoverBg" Color="#2AFFFFFF" />
          <SolidColorBrush x:Key="RowOpenBg" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="OutcomeBg" Color="#2BFFFFFF" />
          <SolidColorBrush x:Key="MutedFg" Color="#ABABAB" />
          <SolidColorBrush x:Key="SidebarBg" Color="#00ffffff" />
          <SolidColorBrush x:Key="SidebarFallbackBg" Color="#202020" />
          <SolidColorBrush x:Key="MainBg" Color="#c0202020" />
          <SolidColorBrush x:Key="SidebarWallpaperTint" Color="#e0202020" />
          <SolidColorBrush x:Key="MainWallpaperTint" Color="#f0202020" />
          <SolidColorBrush x:Key="SidebarDivider" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="CardBg" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="RunSelectedBg" Color="#1FFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,Courier New,monospace" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Severity chips -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="Margin" Value="0,2,6,2" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.bug"><Setter Property="Background" Value="{DynamicResource BugBg}" /></Style>
    <Style Selector="Border.chip.bug TextBlock"><Setter Property="Foreground" Value="{DynamicResource BugFg}" /></Style>
    <Style Selector="Border.chip.risk"><Setter Property="Background" Value="{DynamicResource RiskBg}" /></Style>
    <Style Selector="Border.chip.risk TextBlock"><Setter Property="Foreground" Value="{DynamicResource RiskFg}" /></Style>
    <Style Selector="Border.chip.design"><Setter Property="Background" Value="{DynamicResource DesignBg}" /></Style>
    <Style Selector="Border.chip.design TextBlock"><Setter Property="Foreground" Value="{DynamicResource DesignFg}" /></Style>
    <Style Selector="Border.chip.nit"><Setter Property="Background" Value="{DynamicResource NitBg}" /></Style>
    <Style Selector="Border.chip.nit TextBlock"><Setter Property="Foreground" Value="{DynamicResource NitFg}" /></Style>
    <Style Selector="TextBlock.sev"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.sev.bug"><Setter Property="Foreground" Value="{DynamicResource BugFg}" /></Style>
    <Style Selector="TextBlock.sev.risk"><Setter Property="Foreground" Value="{DynamicResource RiskFg}" /></Style>
    <Style Selector="TextBlock.sev.design"><Setter Property="Foreground" Value="{DynamicResource DesignFg}" /></Style>
    <Style Selector="TextBlock.sev.nit"><Setter Property="Foreground" Value="{DynamicResource NitFg}" /></Style>
    <Style Selector="TextBlock.fix"><Setter Property="Foreground" Value="{DynamicResource FixFg}" /></Style>
    <Style Selector="TextBlock.reject"><Setter Property="Foreground" Value="{DynamicResource RejectFg}" /></Style>
    <Style Selector="Path.fix"><Setter Property="Stroke" Value="{DynamicResource FixFg}" /></Style>
    <Style Selector="Path.reject"><Setter Property="Stroke" Value="{DynamicResource RejectFg}" /></Style>

    <!-- Summary table rows: a flat toggle button per round -->
    <Style Selector="ToggleButton.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.row:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowOpenBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.row:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBg}" />
    </Style>
    <Style Selector="ToggleButton.row.live /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LiveBg}" />
    </Style>

    <!-- Reviewer activity logs (the Details window and the discussion inspector) -->
    <Style Selector=":is(TextBlock).log">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,Courier New,monospace" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector=":is(TextBlock).log.prose">
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector=":is(TextBlock).log.toolcall"><Setter Property="Foreground" Value="{DynamicResource LiveFg}" /></Style>
    <Style Selector=":is(TextBlock).log.toolresult"><Setter Property="Foreground" Value="{DynamicResource MutedFg}" /></Style>
    <Style Selector=":is(TextBlock).log.thinking">
      <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector=":is(TextBlock).log.error"><Setter Property="Foreground" Value="{DynamicResource BugFg}" /></Style>
    <Style Selector=":is(TextBlock).log.retry"><Setter Property="Foreground" Value="{DynamicResource AwaitFg}" /></Style>
    <Style Selector=":is(TextBlock).log.info">
      <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Path.dimstroke"><Setter Property="Stroke" Value="{DynamicResource MutedFg}" /></Style>
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:RoundHeader">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TableBorder}" Margin="0,14,0,6" Padding="0,0,0,4">
        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:ActivityEntryViewModel">
      <StackPanel Margin="0,1">
        <!-- Foldable: a one-line headline that toggles the full content below it -->
        <ToggleButton Classes="row" Padding="4,3" MinHeight="0" CornerRadius="4"
                      IsVisible="{Binding CanExpand}" IsChecked="{Binding IsExpanded}">
          <DockPanel>
            <Panel Width="10" Margin="0,0,6,0" VerticalAlignment="Center">
              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsExpanded}" />
              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsExpanded}" />
            </Panel>
            <TextBlock Classes="log" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                       Classes.prose="{Binding IsText}" Classes.toolcall="{Binding IsToolCall}"
                       Classes.toolresult="{Binding IsToolResult}" Classes.thinking="{Binding IsThinking}"
                       Classes.error="{Binding IsError}" Classes.retry="{Binding IsRetry}" Classes.info="{Binding IsInfo}" />
          </DockPanel>
        </ToggleButton>
        <Border Background="{DynamicResource RowOpenBg}" CornerRadius="4" Padding="10,6" Margin="20,1,0,4"
                IsVisible="{Binding IsExpanded}">
          <SelectableTextBlock Classes="log" Text="{Binding Detail}" TextWrapping="Wrap"
                               Classes.toolcall="{Binding IsToolCall}" Classes.thinking="{Binding IsThinking}"
                               Classes.error="{Binding IsError}" />
        </Border>

        <!-- Short enough to show as it is -->
        <SelectableTextBlock Classes="log" Text="{Binding Text}" TextWrapping="Wrap" Margin="20,3,4,3"
                             IsVisible="{Binding !CanExpand}"
                             Classes.prose="{Binding IsText}" Classes.toolcall="{Binding IsToolCall}"
                             Classes.toolresult="{Binding IsToolResult}" Classes.thinking="{Binding IsThinking}"
                             Classes.error="{Binding IsError}" Classes.retry="{Binding IsRetry}" Classes.info="{Binding IsInfo}" />
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
