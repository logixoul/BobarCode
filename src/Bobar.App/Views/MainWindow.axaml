<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobar.App.ViewModels"
        x:Class="Bobar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico" Title="BobarCode" Width="1280" Height="820" MinWidth="1000" MinHeight="400">
  <Window.Styles>
    <Style Selector="TextBlock.th">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.livefg"><Setter Property="Foreground" Value="{DynamicResource LiveFg}" /></Style>
    <Style Selector="TextBlock.await"><Setter Property="Foreground" Value="{DynamicResource AwaitFg}" /></Style>
    <Style Selector="Path.bug"><Setter Property="Stroke" Value="{DynamicResource BugFg}" /></Style>
    <Style Selector="Path.dimstroke"><Setter Property="Stroke" Value="{DynamicResource MutedFg}" /></Style>
    <Style Selector="Panel.hidden"><Setter Property="Opacity" Value="0" /></Style>
  </Window.Styles>
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="Open config" Command="{Binding OpenConfigCommand}" />
        <TextBlock Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="620" />
      </Grid.ColumnDefinitions>
      <!-- Runs, grouped by repo, newest first -->
      <ListBox Grid.Column="0" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RunItemViewModel">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding RepoName}" FontWeight="Bold" FontSize="13" Margin="0,4,0,2" IsVisible="{Binding ShowRepoHeader}" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding BadgeBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White" />
                </Border>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <TextBlock Grid.Column="2" Classes="muted" Text="Select a run." HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}" />

      <!-- The selected run -->
      <DockPanel Grid.Column="2" Margin="16,10,12,8" DataContext="{Binding Detail}" x:DataType="vm:RunDetailViewModel"
                 IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel Spacing="2">
            <WrapPanel>
              <SelectableTextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                      IsVisible="{Binding StatusLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
              </Border>
            </WrapPanel>
            <TextBlock Classes="dim" Text="{Binding Subtitle}" TextWrapping="Wrap" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Foreground="#E8590C" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Foreground="#2F9E44" Text="{Binding Banner}" TextWrapping="Wrap" IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <Button Content="Details" Command="{Binding OpenDetailsCommand}" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
          </StackPanel>
        </Grid>

        <TabControl>
          <TabItem Header="Summary">
            <ScrollViewer Padding="0,8,10,8">
              <StackPanel Spacing="12">
                <TextBlock Classes="dim" Text="Starting…" IsVisible="{Binding !Table.HasRounds}" />

                <!-- One row per round; click a round to see its findings. The window's MinWidth keeps it from getting too narrow. -->
                <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        IsVisible="{Binding Table.HasRounds}">
                  <StackPanel>
                    <Border Background="{DynamicResource TableHeaderBg}" Padding="12,0" Height="32">
                      <Grid ColumnDefinitions="56,*,190,76,76">
                        <TextBlock Classes="th" Text="Round" />
                        <TextBlock Classes="th" Grid.Column="1" Text="Reviewer found" />
                        <TextBlock Classes="th" Grid.Column="2" Text="Author" />
                        <TextBlock Classes="th" Grid.Column="3" Text="Time" HorizontalAlignment="Right" />
                        <TextBlock Classes="th" Grid.Column="4" Text="Cost" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Table.Rounds}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoundRowViewModel">
                          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource RowBorder}">
                            <StackPanel>
                              <ToggleButton Classes="row" Classes.live="{Binding IsLive}" IsChecked="{Binding IsExpanded}"
                                            IsHitTestVisible="{Binding CanExpand}" Focusable="{Binding CanExpand}">
                                <Grid ColumnDefinitions="56,*,190,76,76">
                                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Panel Width="10" VerticalAlignment="Center" Classes.hidden="{Binding !CanExpand}">
                                      <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                            Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsExpanded}" />
                                      <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                            Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsExpanded}" />
                                    </Panel>
                                    <TextBlock Classes="dim" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipViewModel">
                                          <Border Classes="chip" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                                  Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}">
                                            <TextBlock Text="{Binding Text}" />
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="dim" Classes.livefg="{Binding IsLive}" FontSize="12" VerticalAlignment="Center" Margin="0,2"
                                               Text="{Binding ReviewerNote}" TextWrapping="Wrap" />
                                  </WrapPanel>
                                  <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0"
                                                IsVisible="{Binding FixText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <Path Classes="fix" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Data="M1,5 L4,8 L10,1" />
                                      <TextBlock Classes="fix" Text="{Binding FixText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0"
                                                IsVisible="{Binding RejectText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <Path Classes="reject" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" Data="M1,1 L8,8 M8,1 L1,8" />
                                      <TextBlock Classes="reject" Text="{Binding RejectText}" />
                                    </StackPanel>
                                    <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center" Text="{Binding AuthorNote}" />
                                  </WrapPanel>
                                  <TextBlock Grid.Column="3" Classes="num" Classes.livefg="{Binding IsLive}" VerticalAlignment="Center" Text="{Binding Time}" />
                                  <TextBlock Grid.Column="4" Classes="num" VerticalAlignment="Center" Text="{Binding Cost}" />
                                </Grid>
                              </ToggleButton>

                              <!-- The round's findings -->
                              <Border Background="{DynamicResource RowOpenBg}" Padding="68,2,12,8" IsVisible="{Binding IsExpanded}">
                                <ItemsControl ItemsSource="{Binding Findings}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingViewModel">
                                      <Grid ColumnDefinitions="52,64,*,80" MinHeight="26">
                                        <TextBlock Classes="dim" FontSize="12.5" VerticalAlignment="Center" Text="{Binding Id}" />
                                        <TextBlock Grid.Column="1" Classes="sev" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                                   Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}"
                                                   FontSize="12.5" VerticalAlignment="Center" Text="{Binding Severity}" />
                                        <TextBlock Grid.Column="2" FontSize="12.5" VerticalAlignment="Center" Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3" Classes.fix="{Binding IsFixed}" Classes.reject="{Binding IsRejected}"
                                                   FontSize="12.5" VerticalAlignment="Center" Text="{Binding Action}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- You: waiting for, or showing, your decisions -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource RowBorder}" Background="{DynamicResource AwaitBg}"
                            Padding="12,0" MinHeight="40" IsVisible="{Binding Table.HasDecision}">
                      <Grid ColumnDefinitions="56,*,190,76,76" VerticalAlignment="Center">
                        <TextBlock Classes="await" VerticalAlignment="Center" Text="You" />
                        <TextBlock Grid.Column="1" Classes="await" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Table.DecisionText}" />
                        <TextBlock Grid.Column="2" Classes="await" VerticalAlignment="Center" Text="{Binding Table.DecisionNote}" />
                        <TextBlock Grid.Column="3" Classes="await num" VerticalAlignment="Center" Text="{Binding Table.DecisionTime}" />
                      </Grid>
                    </Border>

                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource TableBorder}" Background="{DynamicResource TableTotalBg}"
                            Padding="12,0" Height="38">
                      <Grid ColumnDefinitions="56,*,190,76,76" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Total" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Table.TotalFindings}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Table.TotalAuthor}" />
                        <TextBlock Grid.Column="3" Classes="num" FontWeight="SemiBold" Text="{Binding Table.TotalTime}" />
                        <TextBlock Grid.Column="4" Classes="num" FontWeight="SemiBold" Text="{Binding Table.TotalCost}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- How it ended -->
                <Border Background="{DynamicResource OutcomeBg}" CornerRadius="6" Padding="12,10" IsVisible="{Binding Table.HasOutcome}">
                  <DockPanel>
                    <Panel DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                      <Path Classes="fix" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding Table.OutcomeIsGood}"
                            Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5,8.2 L7,10.2 L11,5.8" />
                      <Path Classes="bug" StrokeThickness="1.6" StrokeLineCap="Round" IsVisible="{Binding Table.OutcomeIsError}"
                            Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5.5,5.5 L10.5,10.5 M10.5,5.5 L5.5,10.5" />
                    </Panel>
                    <SelectableTextBlock Text="{Binding Table.Outcome}" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>

                <!-- Decisions panel, while the run awaits your decisions -->
                <Panel IsVisible="{Binding ShowDecisions}">
                <StackPanel DataContext="{Binding Decisions}" x:DataType="vm:DecisionsViewModel" Spacing="10">
                  <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DecisionCardViewModel">
                        <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource TableBorder}">
                          <StackPanel Spacing="8">
                            <WrapPanel>
                              <Border Classes="chip" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                      Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Severity}" />
                              </Border>
                              <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                              <SelectableTextBlock Classes="mono" Text="{Binding Refs}" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasRefs}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto">
                              <TextBlock Classes="dim" Text="Reviewer" />
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Explanation}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="1" Classes="dim" Text="Author" Margin="0,8,0,0" />
                              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuthorReasoning}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </Grid>
                            <Expander Header="Earlier rounds" IsVisible="{Binding HasThread}" HorizontalAlignment="Stretch">
                              <SelectableTextBlock Text="{Binding Thread}" TextWrapping="Wrap" />
                            </Expander>
                            <WrapPanel>
                              <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsFix}" Content="Fix it (side with the reviewer)" Margin="0,0,16,0" />
                              <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsDismiss}" Content="Dismiss (side with the author)" Margin="0,0,16,0" />
                              <Button Content="Add comment" Command="{Binding AddCommentCommand}" IsVisible="{Binding !ShowComment}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBox Text="{Binding Comment}" IsVisible="{Binding ShowComment}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" Watermark="Comment for the author" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Text="{Binding OverallComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                           Watermark="Optional overall comment" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Submit" Command="{Binding SubmitCommand}" Classes="accent" Padding="20,6" />
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Choose fix or dismiss for every finding to submit."
                               IsVisible="{Binding !AllChosen}" />
                    <TextBlock Foreground="#C92A2A" VerticalAlignment="Center" Text="{Binding Error}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
                </Panel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Exchange">
            <ScrollViewer>
              <SelectableTextBlock Classes="mono" Margin="0,6" Text="{Binding ExchangeText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
