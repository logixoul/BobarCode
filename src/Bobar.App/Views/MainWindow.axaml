<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobar.App.ViewModels"
        xmlns:st="using:Bobar.Core.State"
        x:Class="Bobar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BobarCode" Width="1280" Height="820" MinWidth="700" MinHeight="400">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Open config" Command="{Binding OpenConfigCommand}" />
        <TextBlock Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="340,4,*">
      <!-- Runs, grouped by repo, newest first -->
      <ListBox Grid.Column="0" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RunItemViewModel">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding RepoName}" FontWeight="Bold" FontSize="13" Margin="0,4,0,2" IsVisible="{Binding ShowRepoHeader}" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding BadgeBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White" />
                </Border>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <TextBlock Grid.Column="2" Classes="muted" Text="Select a run." HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}" />

      <!-- The selected run -->
      <DockPanel Grid.Column="2" Margin="12,8,12,8" DataContext="{Binding Detail}" x:DataType="vm:RunDetailViewModel"
                 IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <StackPanel>
            <SelectableTextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            <TextBlock Foreground="#E8590C" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Foreground="#2F9E44" Text="{Binding Banner}" TextWrapping="Wrap" IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <Button Content="Details" Command="{Binding OpenDetailsCommand}" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
          </StackPanel>
        </Grid>

        <TabControl>
          <TabItem Header="Summary">
            <Grid RowDefinitions="*,*">
              <ScrollViewer Grid.Row="0" Grid.RowSpan="{Binding FeedRowSpan}" Name="FeedScroll">
                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,6">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="st:SummaryLine">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="muted" Margin="16,0,0,0" Text="{Binding Detail}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Decisions panel: replaces the lower half while the run awaits decisions -->
              <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      IsVisible="{Binding ShowDecisions}">
                <ScrollViewer DataContext="{Binding Decisions}" x:DataType="vm:DecisionsViewModel" Padding="0,8,8,8">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DecisionCardViewModel">
                          <Border Margin="0,0,0,10" Padding="12" CornerRadius="6" BorderThickness="1"
                                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <StackPanel Spacing="6">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#E8590C" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11" />
                                </Border>
                                <SelectableTextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              </StackPanel>
                              <SelectableTextBlock Classes="mono" Text="{Binding Refs}" Opacity="0.7" IsVisible="{Binding HasRefs}" />
                              <TextBlock Text="Reviewer:" FontWeight="SemiBold" />
                              <SelectableTextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                              <TextBlock Text="Author's reasoning for rejecting it:" FontWeight="SemiBold" />
                              <SelectableTextBlock Text="{Binding AuthorReasoning}" TextWrapping="Wrap" />
                              <Expander Header="Earlier rounds" IsVisible="{Binding HasThread}" HorizontalAlignment="Stretch">
                                <SelectableTextBlock Text="{Binding Thread}" TextWrapping="Wrap" />
                              </Expander>
                              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsFix}" Content="Fix it (side with the reviewer)" />
                                <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsDismiss}" Content="Dismiss (side with the author)" />
                                <Button Content="Add comment" Command="{Binding AddCommentCommand}" IsVisible="{Binding !ShowComment}" />
                              </StackPanel>
                              <TextBox Text="{Binding Comment}" IsVisible="{Binding ShowComment}" AcceptsReturn="True" TextWrapping="Wrap"
                                       MinHeight="60" Watermark="Comment for the author" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding OverallComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                             Watermark="Optional overall comment" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Content="Submit" Command="{Binding SubmitCommand}" Classes="accent" Padding="20,6" />
                      <TextBlock Classes="muted" VerticalAlignment="Center" Text="Choose fix or dismiss for every finding to submit."
                                 IsVisible="{Binding !AllChosen}" />
                      <TextBlock Foreground="#C92A2A" VerticalAlignment="Center" Text="{Binding Error}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Exchange">
            <ScrollViewer>
              <SelectableTextBlock Classes="mono" Margin="0,6" Text="{Binding ExchangeText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
