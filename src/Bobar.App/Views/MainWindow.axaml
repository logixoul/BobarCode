<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobar.App.ViewModels"
        xmlns:v="using:Bobar.App.Views"
        x:Class="Bobar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico" Title="BobarCode" Width="1280" Height="820" MinWidth="1000" MinHeight="400">
  <Window.Styles>
    <Style Selector="TextBlock.th">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.livefg"><Setter Property="Foreground" Value="{DynamicResource LiveFg}" /></Style>
    <Style Selector="TextBlock.await"><Setter Property="Foreground" Value="{DynamicResource AwaitFg}" /></Style>
    <Style Selector="Path.bug"><Setter Property="Stroke" Value="{DynamicResource BugFg}" /></Style>
    <Style Selector="Path.dimstroke"><Setter Property="Stroke" Value="{DynamicResource MutedFg}" /></Style>
    <Style Selector="Panel.hidden"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="SelectableTextBlock.dimsel"><Setter Property="Foreground" Value="{DynamicResource MutedFg}" /></Style>
    <Style Selector="Button.cell"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.cell.selected"><Setter Property="Background" Value="{DynamicResource RowOpenBg}" /></Style>
    <Style Selector="Button.cell.selected TextBlock.celltext"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.seg"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="10,4" /></Style>
    <Style Selector="Button.seg.on"><Setter Property="Background" Value="{DynamicResource RowOpenBg}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.dropped"><Setter Property="Foreground" Value="{DynamicResource BugFg}" /></Style>
  </Window.Styles>
  <Window.DataTemplates>
    <!-- A finding the author's hindsight regrets its call on: click to see the finding and how it was answered. -->
    <DataTemplate DataType="vm:HindsightRowViewModel">
      <StackPanel>
        <ToggleButton Classes="row" Padding="4,4" MinHeight="0" IsChecked="{Binding IsExpanded}"
                      IsHitTestVisible="{Binding CanExpand}" Focusable="{Binding CanExpand}">
          <Grid ColumnDefinitions="16,52,64,*">
            <Panel Width="10" VerticalAlignment="Top" Margin="0,4,0,0" Classes.hidden="{Binding !CanExpand}">
              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsExpanded}" />
              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsExpanded}" />
            </Panel>
            <TextBlock Grid.Column="1" Classes="dim" FontSize="12.5" Text="{Binding Id}" />
            <TextBlock Grid.Column="2" Classes="sev" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                       Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}" FontSize="12.5" Text="{Binding Severity}" />
            <StackPanel Grid.Column="3">
              <TextBlock FontSize="12.5" Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="dim" FontSize="12.5" Text="{Binding Why}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ToggleButton>
        <Border Background="{DynamicResource RowOpenBg}" CornerRadius="4" Padding="20,8,12,10" Margin="0,0,0,4" IsVisible="{Binding IsExpanded}">
          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Classes="dim" FontSize="12.5" Text="Reviewer" IsVisible="{Binding Explanation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <v:MarkdownView Grid.Column="1" FontSize="12.5" Markdown="{Binding Explanation}"
                            IsVisible="{Binding Explanation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Grid.Row="1" Classes="dim" FontSize="12.5" Text="Refs" Margin="0,6,0,0" IsVisible="{Binding HasRefs}" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Refs}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding HasRefs}" />
            <TextBlock Grid.Row="2" Classes="dim" FontSize="12.5" Text="Author said" Margin="0,6,0,0" IsVisible="{Binding HasAuthorAnswer}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,6,0,0" IsVisible="{Binding HasAuthorAnswer}">
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding AuthorAction}"
                         IsVisible="{Binding AuthorAction, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <v:MarkdownView FontSize="12.5" Markdown="{Binding AuthorReasoning}" IsVisible="{Binding HasAuthorReasoning}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Classes="dim" FontSize="12.5" Text="You decided" Margin="0,6,0,0" IsVisible="{Binding HasUserDecision}" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5" Text="{Binding UserDecision}" TextWrapping="Wrap" Margin="0,6,0,0"
                                 IsVisible="{Binding HasUserDecision}" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="Open config" Command="{Binding OpenConfigCommand}" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="Reviewers" Command="{Binding OpenReviewersCommand}"
                ToolTip.Tip="How useful each reviewer has been (from the author's hindsights), next to its cost" />
        <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoDeleteCommand}" IsVisible="{Binding DeletedRunId, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="Bring back the run you just deleted" />
        <TextBlock Classes="muted" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="620" />
      </Grid.ColumnDefinitions>
      <!-- Runs, grouped by repo, newest first -->
      <ListBox Grid.Column="0" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RunItemViewModel">
            <StackPanel Spacing="1" Background="Transparent">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Delete run" Click="OnDeleteRun" IsEnabled="{Binding CanDelete}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <TextBlock Text="{Binding RepoName}" FontWeight="Bold" FontSize="13" Margin="0,4,0,2" IsVisible="{Binding ShowRepoHeader}" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="9" Padding="6,0" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip.Tip="The author's usefulness rating for this run (its hindsight)"
                        IsVisible="{Binding UsefulnessText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding UsefulnessText}" FontSize="11" />
                </Border>
                <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White" />
                </Border>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <TextBlock Grid.Column="2" Classes="muted" Text="Select a run." HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}" />

      <!-- The selected run -->
      <DockPanel Grid.Column="2" Margin="16,10,12,8" DataContext="{Binding Detail}" x:DataType="vm:RunDetailViewModel"
                 IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel Spacing="2">
            <WrapPanel>
              <SelectableTextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                      IsVisible="{Binding StatusLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
              </Border>
            </WrapPanel>
            <TextBlock Classes="dim" Text="{Binding Subtitle}" TextWrapping="Wrap" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Foreground="#E8590C" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Foreground="#2F9E44" Text="{Binding Banner}" TextWrapping="Wrap" IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <Button Content="Copy exchange" Click="OnCopyExchange" IsEnabled="{Binding HasExchange}"
                    ToolTip.Tip="Copy every round's findings with the author's responses (and your decisions) as plain text" />
            <Button Content="Details" Command="{Binding OpenDetailsCommand}" IsVisible="{Binding !IsDiscuss}" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
          </StackPanel>
        </Grid>

            <!-- The run's body: the only zoomed area (Ctrl+wheel, Ctrl +/-/0; see MainWindow.axaml.cs) -->
            <ScrollViewer x:Name="DetailScroll" HorizontalScrollBarVisibility="Auto">
              <!-- Top/Left: the LTC centres its content in its slot, so a stretched one made short bodies jump while zooming. -->
              <LayoutTransformControl x:Name="ZoomRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
              <!-- MinWidth: the detail column's MinWidth (620) minus the panel's margins. Zoomed in past it, the body
                   scrolls sideways instead of squeezing (MainWindow.ApplyZoom reads it). -->
              <StackPanel x:Name="ZoomContent" Spacing="12" Margin="0,8,10,8" MinWidth="590">
                <!-- A review or exploration: its rounds table and outcome -->
                <StackPanel Spacing="12" IsVisible="{Binding !IsDiscuss}">
                <TextBlock Classes="dim" Text="Starting…" IsVisible="{Binding !Table.HasRounds}" />

                <!-- One row per round; click a round to see its findings. The window's MinWidth keeps it from getting too narrow. -->
                <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        IsVisible="{Binding Table.HasRounds}">
                  <StackPanel>
                    <Border Background="{DynamicResource TableHeaderBg}" Padding="12,0" Height="32">
                      <Grid ColumnDefinitions="56,*,190,76,76">
                        <TextBlock Classes="th" Text="Round" />
                        <TextBlock Classes="th" Grid.Column="1" Text="Reviewer found" />
                        <TextBlock Classes="th" Grid.Column="2" Text="Author" />
                        <TextBlock Classes="th" Grid.Column="3" Text="Time" HorizontalAlignment="Right" />
                        <TextBlock Classes="th" Grid.Column="4" Text="Cost" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Table.Rounds}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoundRowViewModel">
                          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource RowBorder}">
                            <StackPanel>
                              <ToggleButton Classes="row" Classes.live="{Binding IsLive}" IsChecked="{Binding IsExpanded}"
                                            IsHitTestVisible="{Binding CanExpand}" Focusable="{Binding CanExpand}">
                                <Grid ColumnDefinitions="56,*,190,76,76">
                                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Panel Width="10" VerticalAlignment="Center" Classes.hidden="{Binding !CanExpand}">
                                      <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                            Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsExpanded}" />
                                      <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                            Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsExpanded}" />
                                    </Panel>
                                    <TextBlock Classes="dim" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipViewModel">
                                          <Border Classes="chip" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                                  Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}">
                                            <TextBlock Text="{Binding Text}" />
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="dim" Classes.livefg="{Binding IsLive}" FontSize="12" VerticalAlignment="Center" Margin="0,2"
                                               Text="{Binding ReviewerNote}" TextWrapping="Wrap" />
                                  </WrapPanel>
                                  <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0"
                                                IsVisible="{Binding FixText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <Path Classes="fix" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Data="M1,5 L4,8 L10,1" />
                                      <TextBlock Classes="fix" Text="{Binding FixText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0"
                                                IsVisible="{Binding RejectText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <Path Classes="reject" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" Data="M1,1 L8,8 M8,1 L1,8" />
                                      <TextBlock Classes="reject" Text="{Binding RejectText}" />
                                    </StackPanel>
                                    <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center" Text="{Binding AuthorNote}" />
                                  </WrapPanel>
                                  <TextBlock Grid.Column="3" Classes="num" Classes.livefg="{Binding IsLive}" VerticalAlignment="Center" Text="{Binding Time}" />
                                  <TextBlock Grid.Column="4" Classes="num" VerticalAlignment="Center" Text="{Binding Cost}" />
                                </Grid>
                              </ToggleButton>

                              <!-- The round's findings -->
                              <Border Background="{DynamicResource RowOpenBg}" Padding="52,2,12,8" IsVisible="{Binding IsExpanded}">
                                <ItemsControl ItemsSource="{Binding Findings}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingViewModel">
                                      <StackPanel>
                                        <ToggleButton Classes="row" Padding="0" MinHeight="26" IsChecked="{Binding IsExpanded}"
                                                      IsHitTestVisible="{Binding CanExpand}" Focusable="{Binding CanExpand}">
                                          <Grid ColumnDefinitions="16,52,64,*,80" MinHeight="26">
                                            <Panel Width="10" VerticalAlignment="Center" Classes.hidden="{Binding !CanExpand}">
                                              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                    Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsExpanded}" />
                                              <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                    Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsExpanded}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="dim" FontSize="12.5" VerticalAlignment="Center" Text="{Binding Id}" />
                                            <TextBlock Grid.Column="2" Classes="sev" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                                       Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}"
                                                       FontSize="12.5" VerticalAlignment="Center" Text="{Binding Severity}" />
                                            <TextBlock Grid.Column="3" FontSize="12.5" VerticalAlignment="Center" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="4" Classes.fix="{Binding IsFixed}" Classes.reject="{Binding IsRejected}"
                                                       FontSize="12.5" VerticalAlignment="Center" Text="{Binding Action}" />
                                          </Grid>
                                        </ToggleButton>
                                        <!-- The finding itself and how it was answered -->
                                        <Border Padding="16,4,12,10" IsVisible="{Binding IsExpanded}">
                                          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                            <TextBlock Classes="dim" FontSize="12.5" Text="Origin" Margin="0,0,0,6" IsVisible="{Binding HasOrigin}" />
                                            <SelectableTextBlock Grid.Column="1" FontSize="12.5" Text="{Binding Origin}" Margin="0,0,0,6" IsVisible="{Binding HasOrigin}" />
                                            <TextBlock Grid.Row="1" Classes="dim" FontSize="12.5" Text="Reviewer" IsVisible="{Binding HasExplanation}" />
                                            <v:MarkdownView Grid.Row="1" Grid.Column="1" FontSize="12.5" Markdown="{Binding Explanation}"
                                                            IsVisible="{Binding HasExplanation}" />
                                            <TextBlock Grid.Row="2" Classes="dim" FontSize="12.5" Text="Refs" Margin="0,6,0,0" IsVisible="{Binding HasRefs}" />
                                            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Refs}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                 IsVisible="{Binding HasRefs}" />
                                            <TextBlock Grid.Row="3" Classes="dim" FontSize="12.5" Text="Author said" Margin="0,6,0,0" IsVisible="{Binding HasAuthorReasoning}" />
                                            <v:MarkdownView Grid.Row="3" Grid.Column="1" FontSize="12.5" Markdown="{Binding AuthorReasoning}" Margin="0,6,0,0"
                                                            IsVisible="{Binding HasAuthorReasoning}" />
                                            <TextBlock Grid.Row="4" Classes="dim" FontSize="12.5" Text="You decided" Margin="0,6,0,0" IsVisible="{Binding HasUserDecision}" />
                                            <SelectableTextBlock Grid.Row="4" Grid.Column="1" FontSize="12.5" Text="{Binding UserDecision}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                 IsVisible="{Binding HasUserDecision}" />
                                          </Grid>
                                        </Border>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- You: waiting for, or showing, your decisions -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource RowBorder}" Background="{DynamicResource AwaitBg}"
                            Padding="12,0" MinHeight="40" IsVisible="{Binding Table.HasDecision}">
                      <Grid ColumnDefinitions="56,*,190,76,76" VerticalAlignment="Center">
                        <TextBlock Classes="await" VerticalAlignment="Center" Text="You" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6">
                          <TextBlock Classes="await" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Table.DecisionText}" />
                          <TextBlock Classes="await" TextWrapping="Wrap" Text="{Binding Table.DecisionComment, StringFormat='Your comment: {0}'}"
                                               IsVisible="{Binding Table.DecisionComment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="await" VerticalAlignment="Center" Text="{Binding Table.DecisionNote}" />
                        <TextBlock Grid.Column="3" Classes="await num" VerticalAlignment="Center" Text="{Binding Table.DecisionTime}" />
                      </Grid>
                    </Border>

                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource TableBorder}" Background="{DynamicResource TableTotalBg}"
                            Padding="12,0" Height="38">
                      <Grid ColumnDefinitions="56,*,190,76,76" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Total" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Table.TotalFindings}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Table.TotalAuthor}" />
                        <TextBlock Grid.Column="3" Classes="num" FontWeight="SemiBold" Text="{Binding Table.TotalTime}" />
                        <TextBlock Grid.Column="4" Classes="num" FontWeight="SemiBold" Text="{Binding Table.TotalCost}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- How it ended -->
                <Border Background="{DynamicResource OutcomeBg}" CornerRadius="6" Padding="12,10" IsVisible="{Binding Table.HasOutcome}">
                  <DockPanel>
                    <Panel DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                      <Path Classes="fix" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding Table.OutcomeIsGood}"
                            Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5,8.2 L7,10.2 L11,5.8" />
                      <Path Classes="bug" StrokeThickness="1.6" StrokeLineCap="Round" IsVisible="{Binding Table.OutcomeIsError}"
                            Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5.5,5.5 L10.5,10.5 M10.5,5.5 L5.5,10.5" />
                    </Panel>
                    <SelectableTextBlock Text="{Binding Table.Outcome}" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>

                </StackPanel>

                <!-- A discussion: the question, rounds × participants, the solution you clicked, your answers, the report -->
                <Panel IsVisible="{Binding IsDiscuss}">
                <StackPanel Spacing="12" DataContext="{Binding Discuss}" x:DataType="vm:DiscussViewModel"
                            IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Expander Header="The question" HorizontalAlignment="Stretch">
                    <v:MarkdownView Markdown="{Binding Question}" />
                  </Expander>
                  <TextBlock Classes="dim" Text="Starting…" IsVisible="{Binding !HasRows}" />

                  <!-- Many participants: only the table scrolls sideways; the inspector below keeps the pane's width. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasRows}">
                  <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" MinWidth="{Binding TableMinWidth}">
                    <StackPanel>
                      <Border Background="{DynamicResource TableHeaderBg}" Padding="12,0" Height="32">
                        <Grid ColumnDefinitions="56,*">
                          <TextBlock Classes="th" Text="Round" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Headers}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="th" Text="{Binding}" Margin="4,0" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </Border>

                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DiscussRowViewModel">
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource RowBorder}" Padding="12,0" MinHeight="36">
                              <Grid ColumnDefinitions="56,*">
                                <TextBlock Classes="dim" Text="{Binding RoundText}" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscussCellViewModel">
                                      <Button Classes="cell" Classes.selected="{Binding IsSelected}" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}"
                                              ToolTip.Tip="{Binding Tip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,6" Margin="0,2,8,2"
                                              AutomationProperties.Name="{Binding Tip}">
                                        <DockPanel>
                                          <!-- A chevron on every cell that opens: pointing down while it is the one shown below -->
                                          <Panel DockPanel.Dock="Left" Width="10" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding CanOpen}">
                                            <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M1,1 L5,5 L1,9" IsVisible="{Binding !IsSelected}" />
                                            <Path Classes="dimstroke" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M1,2 L5,6 L9,2" IsVisible="{Binding IsSelected}" />
                                          </Panel>
                                          <TextBlock Classes="celltext" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                                     Classes.livefg="{Binding IsWorking}" Classes.dropped="{Binding IsDropped}" />
                                        </DockPanel>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource TableBorder}" Background="{DynamicResource TableTotalBg}" Padding="12,0" MinHeight="38">
                        <Grid ColumnDefinitions="56,*">
                          <TextBlock FontWeight="SemiBold" Text="Total" VerticalAlignment="Center" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Totals}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{Binding}" Margin="4,0" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                  </ScrollViewer>
                  <TextBlock Classes="dim" FontSize="12" IsVisible="{Binding HasRows}" Text="{Binding Caption}" TextWrapping="Wrap" />

                  <!-- The turn you clicked: its reply, or its activity (live while it works) -->
                  <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                          <Button Content="Expand all" Command="{Binding ExpandAllCommand}" IsVisible="{Binding ShowActivity}" />
                          <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" IsVisible="{Binding ShowActivity}" />
                          <Button Content="Copy log" Click="OnCopyActivity" IsVisible="{Binding ShowActivity}"
                                  ToolTip.Tip="Copy this turn's activity as plain text, details included" />
                          <Button Content="Close" Command="{Binding CloseSelectionCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                          <Button Classes="seg" Classes.on="{Binding ShowActivity}" Command="{Binding ShowActivityViewCommand}"
                                  Content="{Binding ActivityLabel}" ToolTip.Tip="What it is doing: its thinking, tool calls and their results" />
                          <Button Classes="seg" Classes.on="{Binding ShowReply}" Command="{Binding ShowReplyViewCommand}" Content="Reply"
                                  IsEnabled="{Binding HasReply}" ToolTip.Tip="Its solution and the messages it sent" />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Classes="dropped" Text="{Binding SelectedNote}" TextWrapping="Wrap"
                                 IsVisible="{Binding SelectedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <!-- Bounded, so a long log doesn't push the questions and report away; follows the end while you're there. -->
                      <Panel IsVisible="{Binding ShowActivity}">
                        <ScrollViewer x:Name="ActivityScroll" MaxHeight="460" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                          <ItemsControl ItemsSource="{Binding Activity.Entries}" />
                        </ScrollViewer>
                        <Button x:Name="JumpLatest" Content="Jump to latest ↓" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,20,6" IsVisible="False" Click="OnJumpLatest" />
                      </Panel>
                      <StackPanel Spacing="8" IsVisible="{Binding ShowReply}">
                        <v:MarkdownView Markdown="{Binding SelectedSolution}" />
                        <StackPanel Spacing="4" IsVisible="{Binding HasSelectedMessages}">
                          <TextBlock Classes="th" Text="Messages it sent" />
                          <ItemsControl ItemsSource="{Binding SelectedMessages}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MessageItem">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Recipient, StringFormat='→ {0}:'}" />
                                  <v:MarkdownView Markdown="{Binding Text}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- How it stands -->
                  <Border Background="{DynamicResource OutcomeBg}" CornerRadius="6" Padding="12,10" IsVisible="{Binding HasOutcome}">
                    <DockPanel>
                      <Panel DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                        <Path Classes="fix" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding OutcomeIsGood}"
                              Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5,8.2 L7,10.2 L11,5.8" />
                        <Path Classes="bug" StrokeThickness="1.6" StrokeLineCap="Round" IsVisible="{Binding OutcomeIsError}"
                              Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5.5,5.5 L10.5,10.5 M10.5,5.5 L5.5,10.5" />
                      </Panel>
                      <SelectableTextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                    </DockPanel>
                  </Border>

                  <!-- The author's questions, while it waits for your answers -->
                  <Panel IsVisible="{Binding ShowQuestions}">
                  <StackPanel DataContext="{Binding Questions}" x:DataType="vm:QuestionsViewModel" Spacing="10">
                    <TextBlock Text="The author couldn't settle these disagreements on its own. Answer each one:" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" IsVisible="{Binding HasDecided}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="th" Text="Settled by the author" />
                        <v:MarkdownView Markdown="{Binding Decided}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestionCardViewModel">
                          <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource TableBorder}">
                            <StackPanel Spacing="8">
                              <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <v:MarkdownView Markdown="{Binding Context}" IsVisible="{Binding HasContext}" />
                              <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:QuestionOptionViewModel">
                                    <StackPanel Margin="0,2">
                                      <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsChecked}" Content="{Binding Label}" />
                                      <TextBlock Classes="dim" Text="{Binding Description}" TextWrapping="Wrap" Margin="28,0,0,0" IsVisible="{Binding HasDescription}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button Content="Add comment" Command="{Binding AddCommentCommand}" IsVisible="{Binding !ShowComment}" />
                              <TextBox Text="{Binding Comment}" IsVisible="{Binding ShowComment}" AcceptsReturn="True" TextWrapping="Wrap"
                                       MinHeight="60" PlaceholderText="Comment for the author (or your own answer, instead of an option)" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding OverallComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" PlaceholderText="Optional overall comment" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Content="Submit" Command="{Binding SubmitCommand}" Classes="accent" Padding="20,6" />
                      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Pick an option or write a comment for every question to submit."
                                 IsVisible="{Binding !AllAnswered}" />
                      <TextBlock Foreground="#C92A2A" VerticalAlignment="Center" Text="{Binding Error}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                  </Panel>

                  <!-- Your submitted answers -->
                  <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12"
                          IsVisible="{Binding AnswersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Your answers" FontWeight="SemiBold" FontSize="15" />
                      <SelectableTextBlock Text="{Binding AnswersText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <!-- The author's report -->
                  <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12"
                          IsVisible="{Binding Report, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Report" FontWeight="SemiBold" FontSize="15" />
                      <v:MarkdownView Markdown="{Binding Report}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                </Panel>

                <!-- The author's hindsight on the finished run -->
                <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12"
                        IsVisible="{Binding Hindsight.IsVisible}">
                  <StackPanel Spacing="8">
                    <WrapPanel>
                      <TextBlock Text="Hindsight" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Hindsight.Rating}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"
                                 IsVisible="{Binding Hindsight.HasHindsight}" />
                      <TextBlock Classes="dim" Text="{Binding Hindsight.Anchor}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock Classes="dim" Text="The author hasn't sent its hindsight on this run yet." IsVisible="{Binding !Hindsight.HasHindsight}" />

                    <StackPanel Spacing="2" IsVisible="{Binding Hindsight.HasAcceptedWrongly}">
                      <TextBlock Classes="th" Text="Accepted, but shouldn't have" />
                      <ItemsControl ItemsSource="{Binding Hindsight.AcceptedWrongly}" />
                    </StackPanel>

                    <StackPanel Spacing="2" IsVisible="{Binding Hindsight.HasRejectedWrongly}">
                      <TextBlock Classes="th" Text="Rejected, but shouldn't have" />
                      <ItemsControl ItemsSource="{Binding Hindsight.RejectedWrongly}" />
                    </StackPanel>

                    <v:MarkdownView Markdown="{Binding Hindsight.Notes}"
                                    IsVisible="{Binding Hindsight.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Spacing="4" IsVisible="{Binding Hindsight.HasShouldChange}">
                      <TextBlock Classes="th" Text="What BobarCode should change" />
                      <v:MarkdownView Markdown="{Binding Hindsight.ShouldChange}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Decisions panel, while the run awaits your decisions -->
                <Panel IsVisible="{Binding ShowDecisions}">
                <StackPanel DataContext="{Binding Decisions}" x:DataType="vm:DecisionsViewModel" Spacing="10">
                  <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DecisionCardViewModel">
                        <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource TableBorder}">
                          <StackPanel Spacing="8">
                            <WrapPanel>
                              <Border Classes="chip" Classes.bug="{Binding IsBug}" Classes.risk="{Binding IsRisk}"
                                      Classes.design="{Binding IsDesign}" Classes.nit="{Binding IsNit}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Severity}" />
                              </Border>
                              <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                              <SelectableTextBlock Classes="mono" Text="{Binding Refs}" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasRefs}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto">
                              <TextBlock Classes="dim" Text="Reviewer" />
                              <v:MarkdownView Grid.Column="1" Markdown="{Binding Explanation}" />
                              <TextBlock Grid.Row="1" Classes="dim" Text="Author" Margin="0,8,0,0" />
                              <v:MarkdownView Grid.Row="1" Grid.Column="1" Markdown="{Binding AuthorReasoning}" Margin="0,8,0,0" />
                            </Grid>
                            <Expander Header="Earlier rounds" IsVisible="{Binding HasThread}" HorizontalAlignment="Stretch">
                              <ItemsControl ItemsSource="{Binding Thread}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ThreadItemViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,12">
                                      <SelectableTextBlock FontWeight="SemiBold" Text="{Binding Header}" TextWrapping="Wrap" />
                                      <v:MarkdownView Markdown="{Binding Explanation}" />
                                      <TextBlock Classes="dim" Text="{Binding AuthorLine}" IsVisible="{Binding HasAuthorLine}" />
                                      <v:MarkdownView Markdown="{Binding AuthorReasoning}" IsVisible="{Binding HasAuthorReasoning}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Expander>
                            <WrapPanel>
                              <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsFix}" Content="Fix it (side with the reviewer)" Margin="0,0,16,0" />
                              <RadioButton GroupName="{Binding Id}" IsChecked="{Binding IsDismiss}" Content="Dismiss (side with the author)" Margin="0,0,16,0" />
                              <Button Content="Add comment" Command="{Binding AddCommentCommand}" IsVisible="{Binding !ShowComment}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBox Text="{Binding Comment}" IsVisible="{Binding ShowComment}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" PlaceholderText="Comment for the author" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Text="{Binding OverallComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                           PlaceholderText="Optional overall comment" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Submit" Command="{Binding SubmitCommand}" Classes="accent" Padding="20,6" />
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Choose fix or dismiss for every finding to submit."
                               IsVisible="{Binding !AllChosen}" />
                    <TextBlock Foreground="#C92A2A" VerticalAlignment="Center" Text="{Binding Error}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
                </Panel>
              </StackPanel>
              </LayoutTransformControl>
            </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
