<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobar.App.ViewModels"
        x:Class="Bobar.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/icon.ico" Title="Settings" Width="640" Height="480" MinWidth="400" MinHeight="340" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <TextBlock Text="Theme" FontWeight="Bold" VerticalAlignment="Center" />
      <ComboBox MinWidth="140" ItemsSource="{x:Static vm:SettingsViewModel.ThemeNames}" SelectedIndex="{Binding ThemeIndex}" />
      <TextBlock Text="Backdrop" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{x:Static vm:SettingsViewModel.HasBackdrops}" />
      <ComboBox MinWidth="170" ItemsSource="{x:Static vm:SettingsViewModel.BackdropNames}" SelectedIndex="{Binding BackdropIndex}"
                IsVisible="{x:Static vm:SettingsViewModel.HasBackdrops}"
                ToolTip.Tip="What the sidebar shows through. Blurred wallpaper looks like Acrylic but samples the wallpaper, like Mica; Acrylic shows the windows behind." />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="Reviewer instructions" FontWeight="Bold" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Added to every review, in every repo. Put rules for one project in that repo's CLAUDE.md or AGENTS.md instead: the reviewer reads them, and so does Claude when it writes the code. They win when the two conflict. Saving rewrites config.json, so comments and unknown keys in it are dropped." />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <TextBlock Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Save" Classes="accent" Click="OnSave" />
        <Button Content="Cancel" Click="OnCancel" />
      </StackPanel>
    </StackPanel>
    <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding ConfigLoaded}"
             PlaceholderText="e.g. Prefer lightweight designs." VerticalContentAlignment="Top" />
  </DockPanel>
</Window>
