<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobar.App.ViewModels"
        x:Class="Bobar.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/icon.ico" Title="Settings" Width="640" Height="420" MinWidth="400" MinHeight="300" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="Reviewer instructions" FontWeight="Bold" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Added to every review, in every repo. Put rules for one project in that repo's CLAUDE.md or AGENTS.md instead: the reviewer reads them, and so does Claude when it writes the code. They win when the two conflict. Saving rewrites config.json, so comments and unknown keys in it are dropped." />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <TextBlock Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Save" Classes="accent" IsEnabled="{Binding CanSave}" Click="OnSave" />
        <Button Content="Cancel" Click="OnCancel" />
      </StackPanel>
    </StackPanel>
    <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap"
             PlaceholderText="e.g. Prefer lightweight designs." VerticalContentAlignment="Top" />
  </DockPanel>
</Window>
